@model HrDecisionSupport.Application.Requisitions.CreateJobRequisitionRequest

@{
    ViewData["Title"] = "Yeni İlan Oluştur";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Yeni İş İlanı Tanımla</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">İlan Kodu (Örn: BD-TEST-002)</label>
                        <input asp-for="RequisitionCode" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Pozisyon / Unvan</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama / Detay</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                        <button type="submit" class="btn btn-success">İlanı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>