@model HrDecisionSupport.Application.MatchingExecution.History.JobMatchingRunComparison
@using HrDecisionSupport.Application.MatchingExecution.History
@using HrDecisionSupport.Domain.Enums
@{
    ViewData["Title"] = "Eşleştirme Karşılaştırması";
    var requisitionId = ViewData["RequisitionId"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-controller="JobRequisition"
       asp-action="Details"
       asp-route-id="@requisitionId"
       class="btn btn-outline-secondary">← Eşleştirme Geçmişine Dön</a>
    <span class="badge bg-secondary">Salt Okunur</span>
</div>

<div class="card section-card shadow-sm mb-4">
    <div class="card-body">
        <h3 class="mb-1">Eşleştirme Karşılaştırması</h3>
        <div class="text-muted mb-4">
            <strong>@Model.RunB.JobRequisitionCodeSnapshot</strong>
            &nbsp;·&nbsp; @Model.RunB.JobTitleSnapshot
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="border rounded p-3 h-100">
                    <h5 class="mb-1">Run A</h5>
                    <div class="text-muted mb-3">@Model.RunA.ExecutedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    <div class="row g-2 small">
                        <div class="col-6"><span class="text-muted">RetrievalTopN:</span> <strong>@Model.RunA.RetrievalTopN</strong></div>
                        <div class="col-6"><span class="text-muted">FinalTopN:</span> <strong>@Model.RunA.FinalTopN</strong></div>
                        <div class="col-6"><span class="text-muted">Aday havuzu:</span> @Model.RunA.CandidatePoolCount</div>
                        <div class="col-6"><span class="text-muted">Filtreyi geçen:</span> @Model.RunA.HardFilterPassedCount</div>
                        <div class="col-6"><span class="text-muted">Getirilen:</span> @Model.RunA.RetrievedCandidateCount</div>
                        <div class="col-6"><span class="text-muted">Final:</span> @Model.RunA.FinalCandidateCount</div>
                    </div>
                    <hr />
                    <div class="small text-break"><span class="text-muted">Embedding:</span> <code>@Model.RunA.EmbeddingModelName</code></div>
                    <div class="small text-break"><span class="text-muted">Reranker:</span> <code>@Model.RunA.RerankerModelName</code></div>
                    <div class="small text-break"><span class="text-muted">Retention:</span> <code>@Model.RunA.RetentionModelName</code> / <code>@Model.RunA.RetentionFeatureSchemaVersion</code></div>
                    <div class="small text-break mt-2"><span class="text-muted">Job SHA-256:</span> <code>@Model.RunA.JobDocumentHash</code></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="border rounded p-3 h-100">
                    <h5 class="mb-1">Run B</h5>
                    <div class="text-muted mb-3">@Model.RunB.ExecutedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    <div class="row g-2 small">
                        <div class="col-6"><span class="text-muted">RetrievalTopN:</span> <strong>@Model.RunB.RetrievalTopN</strong></div>
                        <div class="col-6"><span class="text-muted">FinalTopN:</span> <strong>@Model.RunB.FinalTopN</strong></div>
                        <div class="col-6"><span class="text-muted">Aday havuzu:</span> @Model.RunB.CandidatePoolCount</div>
                        <div class="col-6"><span class="text-muted">Filtreyi geçen:</span> @Model.RunB.HardFilterPassedCount</div>
                        <div class="col-6"><span class="text-muted">Getirilen:</span> @Model.RunB.RetrievedCandidateCount</div>
                        <div class="col-6"><span class="text-muted">Final:</span> @Model.RunB.FinalCandidateCount</div>
                    </div>
                    <hr />
                    <div class="small text-break"><span class="text-muted">Embedding:</span> <code>@Model.RunB.EmbeddingModelName</code></div>
                    <div class="small text-break"><span class="text-muted">Reranker:</span> <code>@Model.RunB.RerankerModelName</code></div>
                    <div class="small text-break"><span class="text-muted">Retention:</span> <code>@Model.RunB.RetentionModelName</code> / <code>@Model.RunB.RetentionFeatureSchemaVersion</code></div>
                    <div class="small text-break mt-2"><span class="text-muted">Job SHA-256:</span> <code>@Model.RunB.JobDocumentHash</code></div>
                </div>
            </div>
        </div>

        @if (Model.ModelConfigurationChanged)
        {
            <div class="alert alert-warning mt-3 mb-0">
                Karşılaştırılan çalışmalar farklı model yapılandırmaları kullandı.
                Sayısal skor farkları doğrudan karşılaştırılabilir olmayabilir.
            </div>
        }

        <div class="mt-3">
            <span class="text-muted">Semantik iş dokümanı değişti:</span>
            <span class="badge @(Model.SemanticJobDocumentChanged ? "bg-warning text-dark" : "bg-secondary")">
                @(Model.SemanticJobDocumentChanged ? "EVET" : "HAYIR")
            </span>
        </div>
    </div>
</div>

<div class="card section-card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">Kaydedilmiş Yapılandırma Farkları</div>
    <div class="card-body">
        @if (!Model.ConfigurationComparison.IsAvailable)
        {
            <div class="alert alert-secondary mb-0">Yapılandırma karşılaştırması kullanılamıyor.</div>
        }
        else if (Model.ConfigurationComparison.IsIdentical == true)
        {
            <div class="text-muted">Yapılandırma anlık görüntüleri aynı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Alan</th><th>Run A</th><th>Run B</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var difference in Model.ConfigurationComparison.Differences)
                        {
                            <tr>
                                <td class="fw-semibold">@difference.Field</td>
                                <td>@(difference.ValueA ?? "—")</td>
                                <td>@(difference.ValueB ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="row g-3 text-center mb-4">
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Her İkisinde</div><div class="fs-4 fw-bold">@Model.Summary.PresentInBoth</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Yeni</div><div class="fs-4 fw-bold text-primary">@Model.Summary.New</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Düşen</div><div class="fs-4 fw-bold text-secondary">@Model.Summary.Dropped</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Yukarı</div><div class="fs-4 fw-bold text-success">@Model.Summary.MovedUp</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Aşağı</div><div class="fs-4 fw-bold text-danger">@Model.Summary.MovedDown</div></div></div></div>
    <div class="col-6 col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Değişmedi</div><div class="fs-4 fw-bold">@Model.Summary.Unchanged</div></div></div></div>
</div>

@if (Model.RunA.FinalTopN != Model.RunB.FinalTopN)
{
    <div class="alert alert-info">
        FinalTopN değerleri farklıdır (@Model.RunA.FinalTopN → @Model.RunB.FinalTopN).
        YENİ/DÜŞEN durumu yalnızca kaydedilmiş final sonuç kümelerindeki üyelik farkını gösterir;
        aday kalitesinin değiştiği anlamına gelmez.
    </div>
}

<div class="card section-card shadow-sm mb-5">
    <div class="card-header bg-white fw-bold">Aday Karşılaştırması</div>
    <div class="card-body p-0">
        @if (Model.Candidates.Count == 0)
        {
            <div class="text-muted small p-4">Karşılaştırılacak kaydedilmiş aday sonucu bulunmuyor.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Aday</th>
                            <th>Rank A</th>
                            <th>Rank B</th>
                            <th>Hareket</th>
                            <th>Kademe A → B</th>
                            <th>Kapsama A → B</th>
                            <th>Job Fit A → B</th>
                            <th>Retention A → B</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var candidate in Model.Candidates)
                        {
                            var movement = MovementDisplay(candidate.MovementStatus, candidate.Movement);
                            var retentionA = RetentionDisplay(candidate.RetentionStatusA, candidate.RetentionLabelA);
                            var retentionB = RetentionDisplay(candidate.RetentionStatusB, candidate.RetentionLabelB);
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">@candidate.CandidateDisplayNameSnapshot</div>
                                    <small class="text-muted">@(candidate.CandidateCodeSnapshot ?? "—")</small>
                                </td>
                                <td>@(candidate.RankA?.ToString() ?? "—")</td>
                                <td>@(candidate.RankB?.ToString() ?? "—")</td>
                                <td><span class="badge @movement.CssClass">@movement.Text</span></td>
                                <td>@FormatTransition(candidate.SkillTierA, candidate.SkillTierB)</td>
                                <td class="small">
                                    <div>Z: @FormatPercentTransition(candidate.MandatoryCoverageA, candidate.MandatoryCoverageB)</div>
                                    <div>T: @FormatPercentTransition(candidate.PreferredCoverageA, candidate.PreferredCoverageB)</div>
                                </td>
                                <td>
                                    <div>@FormatScoreTransition(candidate.JobFitScoreA, candidate.JobFitScoreB)</div>
                                    <small class="text-muted">Emb: @FormatScoreTransition(candidate.EmbeddingScoreA, candidate.EmbeddingScoreB)</small><br />
                                    <small class="text-muted">Cross: @FormatScoreTransition(candidate.CrossEncoderRawScoreA, candidate.CrossEncoderRawScoreB)</small>
                                </td>
                                <td class="small">
                                    <span class="badge @retentionA.CssClass">@retentionA.Text</span>
                                    <span class="mx-1">→</span>
                                    <span class="badge @retentionB.CssClass">@retentionB.Text</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private static (string Text, string CssClass) MovementDisplay(
        CandidateMovementStatus status,
        int? movement) =>
        status switch
        {
            CandidateMovementStatus.Up => ($"↑ {movement}", "bg-success"),
            CandidateMovementStatus.Down => ($"↓ {Math.Abs(movement ?? 0)}", "bg-danger"),
            CandidateMovementStatus.New => ("YENİ", "bg-primary"),
            CandidateMovementStatus.Dropped => ("DÜŞEN", "bg-secondary"),
            _ => ("—", "bg-light text-dark")
        };

    private static (string Text, string CssClass) RetentionDisplay(
        RetentionPredictionStatus? status,
        EmployeeRetentionLabelValue? label) =>
        (status, label) switch
        {
            (null, _) => ("—", "bg-light text-dark"),
            (RetentionPredictionStatus.Predicted, EmployeeRetentionLabelValue.Short) =>
                ("Kısa Süreli", "bg-danger"),
            (RetentionPredictionStatus.Predicted, EmployeeRetentionLabelValue.Normal) =>
                ("Normal", "bg-info text-dark"),
            (RetentionPredictionStatus.Predicted, EmployeeRetentionLabelValue.Long) =>
                ("Uzun Süreli (Güvenli)", "bg-success"),
            (RetentionPredictionStatus.InsufficientData, _) =>
                ("Yetersiz Veri", "bg-secondary"),
            _ => ("Kullanılamıyor", "bg-danger")
        };

    private static string FormatTransition<T>(T? valueA, T? valueB) where T : struct =>
        $"{valueA?.ToString() ?? "—"} → {valueB?.ToString() ?? "—"}";

    private static string FormatPercentTransition(decimal? valueA, decimal? valueB) =>
        $"{(valueA.HasValue ? valueA.Value.ToString("P0") : "—")} → {(valueB.HasValue ? valueB.Value.ToString("P0") : "—")}";

    private static string FormatScoreTransition(double? valueA, double? valueB) =>
        $"{(valueA.HasValue ? valueA.Value.ToString("0.0000") : "—")} → {(valueB.HasValue ? valueB.Value.ToString("0.0000") : "—")}";
}
