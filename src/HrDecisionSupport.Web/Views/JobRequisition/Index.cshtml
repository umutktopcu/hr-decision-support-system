@model IEnumerable<HrDecisionSupport.Application.Requisitions.JobRequisitionDto>

@{
    ViewData["Title"] = "İş İlanları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>İş İlanları (Job Requisitions)</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni İlan Oluştur</a>
</div>

<div class="card section-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">İlan Kodu</th>
                        <th>Pozisyon / Başlık</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@req.RequisitionCode</td>
                                <td>@req.Title</td>
                                <!-- Durum alanını şimdilik kaldırıyoruz veya '-' koyuyoruz -->
                                <td><span class="badge bg-secondary">Aktif</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary">İncele</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Henüz kayıtlı bir iş ilanı bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>