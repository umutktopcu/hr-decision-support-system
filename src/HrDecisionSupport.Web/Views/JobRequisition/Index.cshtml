@{
    ViewData["Title"] = "İş Gereksinimleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>İş Gereksinimi Listesi</h2>
    <a asp-controller="JobRequisition" asp-action="Create" class="btn btn-primary">
        + Yeni Gereksinim Oluştur
    </a>
</div>

<!-- Error / Info Alert -->
<div id="listAlert"></div>

<!-- Loading state -->
<div id="loadingSpinner" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yükleniyor...</span>
    </div>
    <p class="text-muted mt-2">Gereksinimler yükleniyor...</p>
</div>

<!-- Empty state -->
<div id="emptyState" class="d-none">
    <div class="card section-card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">Henüz bir iş gereksinimi oluşturulmamış.</p>
            <a asp-controller="JobRequisition" asp-action="Create" class="btn btn-primary">
                + İlk Gereksinimi Oluştur
            </a>
        </div>
    </div>
</div>

<!-- Requisition Table -->
<div id="tableContainer" class="d-none">
    <div class="card section-card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Kod</th>
                            <th>Başlık</th>
                            <th>Pozisyon</th>
                            <th>Departman</th>
                            <th>Durum</th>
                            <th>Min. Deneyim</th>
                            <th>Gereksinim</th>
                            <th>Açılış Tarihi</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="requisitionTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/job-requisition.js" asp-append-version="true"></script>
    <script>
        (async function () {
            const loadingEl  = document.getElementById('loadingSpinner');
            const emptyEl    = document.getElementById('emptyState');
            const tableEl    = document.getElementById('tableContainer');
            const tbodyEl    = document.getElementById('requisitionTableBody');
            const alertEl    = document.getElementById('listAlert');

            try {
                const res = await fetch('/api/job-requisitions');
                if (!res.ok) {
                    const msg = await parseApiError(res);
                    showAlert(alertEl, `Gereksinimler yüklenemedi: ${msg}`, 'danger');
                    loadingEl.classList.add('d-none');
                    return;
                }

                const data = await res.json();

                loadingEl.classList.add('d-none');

                if (!data || data.length === 0) {
                    emptyEl.classList.remove('d-none');
                    return;
                }

                tableEl.classList.remove('d-none');

                data.forEach(r => {
                    const expText = r.minimumRelevantExperienceMonths != null
                        ? `${r.minimumRelevantExperienceMonths} ay`
                        : '—';

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="ps-4 fw-bold">
                            <span class="text-monospace small">${escHtml(r.requisitionCode)}</span>
                        </td>
                        <td>${escHtml(r.title)}</td>
                        <td>${escHtml(r.positionName)}</td>
                        <td>${escHtml(r.departmentName)}</td>
                        <td>${statusBadge(r.jobRequisitionStatus)}</td>
                        <td>${expText}</td>
                        <td>
                            <span class="badge bg-secondary">${r.requirementCount} yetkinlik</span>
                        </td>
                        <td class="small text-muted">${fmtDate(r.openedAt)}</td>
                        <td class="text-end pe-4">
                            <a href="/JobRequisition/Details/${r.id}" class="btn btn-sm btn-outline-primary me-1">Detay</a>
                            <a href="/JobRequisition/Edit/${r.id}" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        </td>`;
                    tbodyEl.appendChild(tr);
                });

            } catch (err) {
                loadingEl.classList.add('d-none');
                showAlert(alertEl, `Bağlantı hatası: ${err.message}`, 'danger');
            }
        })();
    </script>
}
