@model IEnumerable<HrDecisionSupport.Application.Candidates.Dtos.CandidateListItemDto>
@using HrDecisionSupport.Application.Common.Interfaces
@using Microsoft.EntityFrameworkCore
@inject IHrDecisionSupportDbContext DbContext

@{
    ViewData["Title"] = "Aday Yönetimi";
    
    // Yetkinlikleri doğrudan Index.cshtml içinden güvenle çekiyoruz
    var allCompetencies = await DbContext.Competencies
        .Where(c => c.IsActive)
        .OrderBy(c => c.Name)
        .ToListAsync();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Aday Listesi</h2>
</div>

<!-- Filtreleme Alanı -->
<div class="card section-card shadow-sm mb-4">
    <div class="card-body bg-light">
        <!-- Dikkat: form elemanını kaldırdık, sayfanın yenilenmesini istemiyoruz -->
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted small">İsim veya Pozisyon Ara</label>
                <!-- ID eklendi: searchInput -->
                <input type="text" id="searchInput" class="form-control" placeholder="Örn: Yazılım Uzmanı...">
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small">Aranan Yetkinlikler</label>
                <div class="border rounded p-2 bg-white form-control" style="max-height: 85px; overflow-y: auto;">
                    @if (allCompetencies != null && allCompetencies.Any())
        {
            foreach (var comp in allCompetencies)
            {
                <div class="form-check mb-1">
                    <input class="form-check-input skill-checkbox" type="checkbox" value="@comp.Name.ToLower()" id="chk-@comp.Id">
                    <label class="form-check-label small" style="cursor:pointer;" for="chk-@comp.Id">@comp.Name</label>
                </div>
            }
        }
        else
        {
            <span class="text-muted small">Yetkinlikler bulunamadı.</span>
        }
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Min. Deneyim</label>
                <!-- ID ve sayısal Value'lar eklendi: expSelect -->
                <select id="expSelect" class="form-select">
                    <option value="0">Herhangi</option>
                    <option value="1">1+ Yıl</option>
                    <option value="3">3+ Yıl</option>
                    <option value="5">5+ Yıl</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Sırala</label>
                <select class="form-select fw-bold text-primary">
                    <option value="score_desc">En Yüksek Uyum Skoru</option>
                    <option value="date_desc">En Yeni Eklenenler</option>
                </select>
            </div>
            <div class="col-md-2">
                <!-- ID eklendi ve type="button" yapıldı: filterBtn -->
                <button type="button" id="filterBtn" class="btn btn-primary w-100">Filtrele</button>
            </div>
        </div>
    </div>
</div>

<!-- Aday Tablosu -->
<div class="card section-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Aday Adı</th>
                        <th>Başvurduğu Pozisyon</th>
                        <th>Deneyim</th>
                        <th>Ana Yetkinlikler</th>
                        <th>Uyum Skoru</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <!-- ID eklendi: candidateTableBody -->
                <!-- ID eklendi: candidateTableBody -->
                <tbody id="candidateTableBody">
                    @if (Model != null)
                    {
                        @foreach (var candidate in Model)
                        {
                            <tr>
                                <!-- İsim varsa İsim Soyisim, yoksa Aday Kodu yazsın -->
                                <td class="ps-4 fw-bold">
                                    @(candidate.FirstName != null && candidate.LastName != null
                                        ? $"{candidate.FirstName} {candidate.LastName}"
                                        : (candidate.CandidateCode ?? "İsimsiz Aday"))
                                </td>

                                <!-- Başvurduğu Pozisyon -->
                                <!-- Başvurduğu Pozisyon (Gerçek Veri) -->
                                <td>
                                    @(string.IsNullOrEmpty(candidate.ProfessionalTitle) ? "Belirtilmemiş" : candidate.ProfessionalTitle)
                                </td>

                                <!-- Deneyim (DTO'dan gelen gerçek veri, eğer yoksa 0 Yıl yazsın) -->
                                <td class="exp-cell">
                                    @(candidate.TotalExperienceYears != null ? $"{candidate.TotalExperienceYears} Yıl" : "-")
                                </td>

                                <!-- Beceriler (Eğer liste halinde geliyorsa aralarına virgül koyarak yazdırıyoruz) -->
                                <td class="skills-cell">
                                    @if (candidate.Skills != null && candidate.Skills.Any())
                                    {
                                        foreach (var skill in candidate.Skills)
                                        {
                                            <span class="badge bg-secondary me-1">@skill</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Belirtilmemiş</span>
                                    }
                                </td>

                                <!-- Uyum Skoru (Eğer eşleştirme listesindeysek) -->
                                <td>
                                    @if (candidate.MatchScore != null)
                                    {
                                        <span class="badge bg-success" style="font-size: 0.9em;">%@candidate.MatchScore</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.8em;">Hesaplanmadı</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@candidate.Id" class="btn btn-sm btn-outline-primary">Profili İncele</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Frontend Filtreleme Mantığı (JavaScript) -->
@section Scripts {
    <script>
        document.getElementById('filterBtn').addEventListener('click', function() {
            // Arama ve filtre değerlerini al
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const expFilter = parseInt(document.getElementById('expSelect').value) || 0;

            // Seçili yetkinlikleri al
            const skillCheckboxes = document.querySelectorAll('.skill-checkbox:checked');
            const selectedSkills = Array.from(skillCheckboxes).map(cb => cb.value.toLowerCase());

            const rows = document.querySelectorAll('#candidateTableBody tr');

            rows.forEach(row => {
                const name = row.cells[0].innerText.toLowerCase();
                const position = row.cells[1].innerText.toLowerCase();
                
                // GÜVENLİ RAKAM OKUMA ("9 Yıl" metninden sadece 9'u alır)
                const expText = row.cells[2].innerText;
                const expMatch = expText.match(/\d+/);
                const expYears = expMatch ? parseInt(expMatch[0]) : 0;

                const skills = row.cells[3].innerText.toLowerCase();

                // Eşleşme Mantıkları
                const matchSearch = name.includes(searchText) || position.includes(searchText);
                const matchExp = expYears >= expFilter;
                const matchSkill = selectedSkills.length === 0 || selectedSkills.every(skill => skills.includes(skill));

                // Tüm şartlar sağlanıyorsa göster, yoksa gizle
                if (matchSearch && matchSkill && matchExp) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}