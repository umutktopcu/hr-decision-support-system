<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - İK Yönetimi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Your custom CSS is linked here -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar Area -->
    <div class="sidebar">
        <div class="logo">İK Sistem</div>
        <div class="sidebar-menu">
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="Employee" asp-action="Index">Çalışan Yönetimi</a>
            <a asp-controller="Candidate" asp-action="Index">Aday Yönetimi</a>
            <a asp-controller="JobRequisition" asp-action="Index">İş İlanları</a> 
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main">
        <div class="topbar">
            <h5>Hoş Geldiniz, İK Yöneticisi</h5>
        </div>

        <div class="page">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>