<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Çalışan Profili</h2>
        <div>
            <a href="/Employee/Index" class="btn btn-outline-secondary me-2">Listeye Dön</a>
            <!-- Butonu Modal açacak şekilde güncelledik -->
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editEmployeeModal">
                Profili Düzenle
            </button>
        </div>
    </div>


    <div class="row">
        <!-- Sol Taraf: Özet Kartı -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 120px; height: 120px;">
                        <span class="fs-1 text-secondary">AE</span>
                    </div>
                    <!-- İsim ve Pozisyon için ID eklendi -->
                    <h4 class="card-title fw-bold" id="empProfileName">Ahmet Erdem</h4>
                    <p class="text-muted mb-1" id="empProfilePosition">Kıdemli Sistem Yöneticisi</p>
                    <span class="badge bg-success mb-3">Aktif Çalışan</span>

                    <ul class="list-group list-group-flush text-start mt-3">
                        <li class="list-group-item px-0"><strong>Departman:</strong> Bilgi Teknolojileri (IT)</li>
                        <!-- Email ve Telefon içine span ile ID eklendi -->
                        <li class="list-group-item px-0"><strong>Email:</strong> <span id="empProfileEmail">ahmet.erdem@sirket.com</span></li>
                        <li class="list-group-item px-0"><strong>Telefon:</strong> <span id="empProfilePhone">+90 532 987 65 43</span></li>
                        <li class="list-group-item px-0"><strong>İşe Başlama:</strong> 15.03.2021</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- Sağ Taraf: Detay Sekmeleri (Tabs) -->
