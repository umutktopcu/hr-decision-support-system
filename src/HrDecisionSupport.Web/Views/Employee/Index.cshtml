@model IReadOnlyList<HrDecisionSupport.Application.Employees.Dtos.EmployeeListItemDto>
@{
    ViewData["Title"] = "Çalışan Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Çalışan Listesi</h2>
    <button class="btn btn-primary">
        + Yeni Çalışan Ekle
    </button>
</div>

<!-- Filtreleme Alanı -->
<div class="card section-card shadow-sm mb-4">
    <div class="card-body bg-light">
        
        <!-- method="get" ve action="/Employee/Index" eklenerek Controller'a bağlandı -->
        <form method="get" action="/Employee/Index" class="row g-3 align-items-end">
            
            <div class="col-md-4">
                <label class="form-label text-muted small">İsim veya Pozisyon Ara</label>
                <!-- name="search" eklendi -->
                <input type="text" name="search" class="form-control" placeholder="Örn: Ahmet Yılmaz...">
            </div>
            
            <div class="col-md-3">
                <label class="form-label text-muted small">Departman</label>
                <!-- name="department" eklendi -->
                <select name="department" class="form-select">
                    <option value="Tümü">Tümü</option>
                    <option value="Yazılım">Yazılım</option>
                    <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                    <option value="Satış & Pazarlama">Satış & Pazarlama</option>
                </select>
            </div>
            
            <div class="col-md-3">
    <label class="form-label text-muted small mb-1">Çalışma Durumu</label>
    <select name="status" class="form-select">
        <!-- Eğer URL'de bir şey yoksa veya 'Tümü' varsa bu seçili kalır -->
        <option value="Tümü" selected="@(Context.Request.Query["status"] == "Tümü" || string.IsNullOrEmpty(Context.Request.Query["status"]))">Tümü</option>
        
        <!-- Eğer URL'de 'Aktif' varsa bu seçili kalır -->
        <option value="Aktif" selected="@(Context.Request.Query["status"] == "Aktif")">Aktif Çalışanlar</option>
        
        <!-- Eğer URL'de 'Eski' varsa bu seçili kalır -->
        <option value="Eski" selected="@(Context.Request.Query["status"] == "Eski")">Eski Çalışanlar</option>
    </select>
</div>
            
            <div class="col-md-2">
                <!-- type="button" yerine type="submit" yapıldı ve JS kodları silindi -->
                <button type="submit" class="btn btn-primary w-100">Ara</button>
            </div>
            
        </form>
        
    </div>
</div>

<!-- Çalışan Tablosu -->
<div class="card section-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mt-4">
                <thead>
                    <tr>
                        <th>Çalışma Adı</th>
                        <th>Departman</th>
                        <th>Unvan</th>
                        <!-- Başlıklar ortalandı -->
                        <th class="text-center">Çalışma Durumu</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(employee.FirstName != null ? $"{employee.FirstName} {employee.LastName}" : $"Çalışan ({employee.EmployeeCode})")</strong><br>
                                <small style="color: #6c757d;">Gizli / Anonim Profil</small>
                            </td>

                            <td>@(employee.CurrentDepartmentName ?? "-")</td>

                            <td>@(employee.CurrentPositionName ?? "-")</td>

                            <!-- Durum Sütunu Ortalandı ve Türkçeleştirildi -->
                            <td class="text-center">
                                @if (employee.EmploymentStatus.ToString() == "Active")
                                {
                                    <span class="badge" style="background-color: #17a2b8; color: white; padding: 5px 10px; border-radius: 5px;">Aktif Çalışan</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #6c757d; color: white; padding: 5px 10px; border-radius: 5px;">Eski Çalışan</span>
                                }
                            </td>

                            <!-- İşlemler Butonu Ortalandı -->
                            <td class="text-center">
                                <a href="/Employee/Details/@employee.Id" class="btn btn-outline-primary btn-sm" style="border: 1px solid #007bff; padding: 4px 15px; border-radius: 4px; text-decoration: none;">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterEmployees() {
            // Input ve Select elemanlarını ID'leri üzerinden yakalıyoruz
            const searchInput = document.getElementById('searchInput');
            const deptSelect = document.getElementById('departmentSelect');
            const workSelect = document.getElementById('workTypeSelect');

            // Değerleri alıyoruz (varsa) ve küçük harfe çeviriyoruz
            const searchText = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const deptFilter = deptSelect ? deptSelect.value.toLowerCase() : '';
            const workFilter = workSelect ? workSelect.value.toLowerCase() : '';

            // Tablonun satırlarını (tr) alıyoruz
            const rows = document.querySelectorAll('#employeeTableBody tr');

            rows.forEach(row => {
                // Hataları önlemek için hücre sayısı kontrolü
                if (row.cells.length < 4) return;

                // DÜZELTİLDİ: Sütun sıraları HTML tablonla birebir eşleştirildi
                const name = row.cells[0].innerText.toLowerCase();       // 1. Sütun: İsim
                const department = row.cells[1].innerText.toLowerCase(); // 2. Sütun: Departman
                const position = row.cells[2].innerText.toLowerCase();   // 3. Sütun: Unvan
                const workType = row.cells[3].innerText.toLowerCase();   // 4. Sütun: Çalışma Şekli

                // Eşleşme kontrolleri (Arama kutusu hem isme hem unvana bakar)
                const matchSearch = name.includes(searchText) || position.includes(searchText);
                const matchDept = deptFilter === "" || department.includes(deptFilter);
                const matchWork = workFilter === "" || workType.includes(workFilter);

                // Tüm şartlar sağlanıyorsa satırı göster, sağlanmıyorsa gizle
                if (matchSearch && matchDept && matchWork) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Kullanıcı klavyeden bir şey yazdığında veya dropdown değiştirdiğinde anında filtrelesin
        document.getElementById('searchInput').addEventListener('keyup', filterEmployees);
        document.getElementById('departmentSelect').addEventListener('change', filterEmployees);
        document.getElementById('workTypeSelect').addEventListener('change', filterEmployees);
    </script>
}